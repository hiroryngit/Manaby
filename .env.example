# manaby - 環境変数テンプレート（全て無料枠で動く構成）
#
#   cp .env.example .env
#
# ⚠️ EXPO_PUBLIC_ 付きの変数はビルド時に JS バンドルへ平文で埋め込まれます。
#    配布後は誰でも読めるため、秘密鍵には絶対に付けないこと。
#    参照は process.env.FOO のドット記法のみ有効（process.env['FOO'] は不可）。

# --- サーバー側（秘密情報・バンドルに含めない） -------------------------------

# Turso（libSQL / SQLite）
# 発行: turso db show manaby --url
#       turso db tokens create manaby
# ⚠️ Turso には Supabase の RLS に相当する行レベル権限がありません。
#    このトークンはDB全体への読み書き権限を持つため、
#    アプリから直接 Turso に接続せず、必ずサーバー経由にすること。
TURSO_DATABASE_URL=libsql://manaby-xxxxx.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.xxxxx

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# `:free` 付きのモデルは完全無料（レート制限あり）。一覧: https://openrouter.ai/models
# 他の無料候補:
#   nvidia/nemotron-3-super-120b-a12b:free  … 120B・出力上限が大きい
#   openai/gpt-oss-20b:free                 … 軽量・応答が速い
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- クライアント（公開情報） -------------------------------------------------

# API サーバーのベース URL（DB アクセスと AI 生成の窓口）
EXPO_PUBLIC_API_BASE_URL=https://manaby.duckdns.org

# Google ログイン（Firebase Auth 経由・無料）
# Google Cloud Console > 認証情報 で OAuth クライアント ID を作成
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxx.apps.googleusercontent.com

# プッシュ通知のトークン取得に必要（`npx eas init` で発行・無料）
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# --- env 変数が不要なもの（参考） --------------------------------------------
# Firebase (Google認証 / Android通知FCM) : google-services.json を配置する方式
